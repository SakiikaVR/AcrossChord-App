{
  "appName": "アクロスコード",
  "packageName": "com.sakiikavr.acrosschord",
  "versionName": "2.1.2",
  "versionCode": 4,
  "webRoot": "www",
  "entry": "index.html",
  "outputFormat": "apk",
  "minSdk": 28,
  "targetSdk": 34,
  "orientation": "portrait",
  "theme": "dark",
  "fullscreen": false,
  "splash": {
    "enabled": false,
    "background": "#000000"
  },
  "lightBackground": "#000000",
  "darkBackground": "#000000",
  "iconPng": "icons/icon.png",
  "iconBackground": "#121216",
  "permissions": [
    "RECORD_AUDIO"
  ],
  "fileAccess": "documents",
  "webview": {
    "javascriptEnabled": true,
    "domStorage": true,
    "database": true,
    "allowUniversalFileAccess": true,
    "mixedContent": false,
    "zoom": false,
    "mediaPlaybackRequiresGesture": false,
    "debuggable": false,
    "userAgentSuffix": "",
    "externalLinksInBrowser": false,
    "backNavigatesHistory": true,
    "pullToRefresh": false,
    "htmlFileInput": true,
    "allowMediaCapture": true,
    "allowGeolocation": false
  },
  "bridge": {
    "globalName": "Android",
    "enableReflection": true,
    "modules": [],
    "traceCalls": false
  },
  "signing": {
    "key": "sakiika-out/sakiika-key.pem"
  },
  "outputDir": "sakiika-out",
  "release": true
}
